#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so a PATH link and invocation from any directory work.
ROOT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$ROOT_DIR"

if [[ "${1:-}" == "setup" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "Usage: sifted setup" >&2
        exit 2
    fi
    PYTHON="${SIFTED_PYTHON:-python3}"
    "$PYTHON" -c 'import sys; sys.exit("SIFTed requires Python 3.11 or newer.") if sys.version_info < (3, 11) else None'
    "$PYTHON" -m venv .venv
    .venv/bin/python -m pip install -r requirements.txt
    echo "Setup complete. Run ./sifted to start the web UI and worker."
    exit 0
fi

if [[ -n "${SIFTED_PYTHON:-}" ]]; then
    PYTHON="$SIFTED_PYTHON"
elif [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
    PYTHON="$ROOT_DIR/.venv/bin/python"
else
    PYTHON="python3"
fi

exec "$PYTHON" -m sifted_core.launcher "$@"
